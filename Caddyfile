example.com {
    root * /var/www/kelidban/dist
    file_server

    # Automatic HTTPS with Let's Encrypt / ZeroSSL

    # Strict Security Headers
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self';"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(self), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        Cross-Origin-Opener-Policy "same-origin"
    }

    # Hashed static assets cache
    @hashedAssets path /assets/* /fonts/*
    header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

    # Service worker freshness
    @sw path /sw.js
    header @sw Cache-Control "no-cache, no-store, must-revalidate"

    # Single Page App fallback
    try_files {path} /index.html
}
